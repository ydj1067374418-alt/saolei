/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
  background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  min-height: 100vh;
}

.card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12px);
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd966;
  text-align: center;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  background: rgba(0, 0, 0, 0.4);
  padding: 8rpx 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #f0f0f0;
  text-align: center;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.progress-fill {
  height: 100%;
  width: 0%;
  transition: width 0.3s ease;
}

.hp-fill, .monster-hp-fill { background: linear-gradient(90deg, #e74c3c, #c0392b); }
.exp-fill { background: linear-gradient(90deg, #2ecc71, #27ae60); }
.tower-fill { background: linear-gradient(90deg, #9b59b6, #8e44ad); }

.progress-label {
  text-align: center;
  font-size: 24rpx;
  color: #ddd;
  margin-top: 8rpx;
}

.boss-btn {
  background: linear-gradient(135deg, #e67e22, #d35400);
  margin-top: 16rpx;
  border-radius: 60rpx;
  color: white;
  font-weight: bold;
  width: 100%;
}
.boss-warning {
  text-align: center;
  color: #f1c40f;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.skill-card {
  padding: 20rpx;
}
.skills-scroll {
  white-space: nowrap;
  width: 100%;
}
.skills-container {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}
.skill-btn {
  background: rgba(0, 0, 0, 0.6);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 1rpx solid #ffd966;
  display: inline-block;
  min-width: 120rpx;
}
.skill-name { font-size: 28rpx; font-weight: bold; color: #ffd966; }
.skill-cost { font-size: 22rpx; color: #5dade2; }
.config-btn { background: rgba(0,0,0,0.8); border-color: #aaa; }

.action-bar {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}
.action-btn {
  flex: 1;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8px);
  border-radius: 60rpx;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  border: 1rpx solid rgba(255,215,0,0.4);
}
.attack-btn { background: linear-gradient(135deg, #e67e22, #d35400); }
.auto-active { background: linear-gradient(135deg, #2ecc71, #27ae60); }
.log-btn { background: linear-gradient(135deg, #3498db, #2980b9); }
.reset-btn { background: linear-gradient(135deg, #7f8c8d, #34495e); }
.btn-hover { transform: scale(0.96); opacity: 0.8; }

/* 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-container {
  background: #1a1a2e;
  border-radius: 32rpx;
  width: 85%;
  max-height: 80%;
  padding: 32rpx;
  border: 1rpx solid #ffd966;
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffd966;
  text-align: center;
  margin-bottom: 24rpx;
}
.log-scroll {
  height: 500rpx;
  overflow-y: auto;
}
.log-item {
  font-size: 24rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
  background: rgba(0,0,0,0.3);
  color: #ddd;
}
.log-item.system { color: #f39c12; border-left: 4rpx solid #f39c12; }
.log-item.combat { color: #e67e22; }
.log-item.skill { color: #2ecc71; }
.log-item.event { color: #9b59b6; }
.modal-close {
  margin-top: 24rpx;
  background: #e67e22;
  color: white;
  border-radius: 60rpx;
}

.skill-config {
  max-height: 80%;
  overflow-y: auto;
}
.skill-library {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 500rpx;
  overflow-y: auto;
}
.config-skill-item {
  background: rgba(0,0,0,0.5);
  border-radius: 24rpx;
  padding: 16rpx;
  position: relative;
  border: 2rpx solid #aaa;
}
.config-skill-item.equipped {
  border-color: #2ecc71;
  background: rgba(46,204,113,0.2);
}
.config-skill-name { font-size: 30rpx; font-weight: bold; color: #ffd966; }
.config-skill-cost { font-size: 24rpx; color: #5dade2; }
.config-skill-desc { font-size: 22rpx; color: #ccc; }
.equipped-mark {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  color: #2ecc71;
  font-size: 40rpx;
  font-weight: bold;
}